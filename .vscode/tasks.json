// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "watch",
			// Wait for both esbuild bundles before launching the extension host.
			"problemMatcher": {
				"owner": "esbuild",
				"pattern": {
					"regexp": "^(.*):(\\d+):(\\d+): error: (.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"message": 4
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^\\[watch\\] starting$",
					"endsPattern": "^\\[watch\\] ready$"
				}
			},
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "Prepare extension tests",
			"dependsOrder": "sequence",
			"dependsOn": ["npm: build", "npm: compile:tests"],
			"problemMatcher": []
		}
	]
}
